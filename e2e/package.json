{
  "name": "gpulist_e2e",
  "version": "1.0.0",
  "main": "index.js",
  "scripts": {
    "server-main": "cd ../server && npm run dev:main-e2e",
    "main-client": "cd ../client && npm run dev",
    "dev:main-test-env": "concurrently 'npm run server-main' 'npm run main-client'",

    "e2e:main": "start-server-and-test dev:main-test-env http://localhost:5173 'cypress run --spec cypress/main-client/**/*.cy.ts run --browser chrome'",
    "e2e:main:chromium": "start-server-and-test dev:main-test-env http://localhost:5173 'cypress run --spec cypress/main-client/**/*.cy.ts --browser chromium'",
    "e2e:main:ui": "start-server-and-test dev:main-test-env http://localhost:5173 'cypress open --config specPattern=\"cypress/main-client/**/*.cy.ts\"'",

    "server-alt": "cd ../server && npm run dev:alt-e2e",
    "alt-client": "cd ../alternative-client && npm run dev",
    "dev:alt-test-env": "concurrently 'npm run server-alt' 'npm run alt-client'",

    "e2e:alt": "start-server-and-test dev:alt-test-env http://localhost:5173 \"cypress run --spec 'cypress/alt-client/**/*.cy.ts' --browser chrome\"",
    "e2e:alt:chromium": "start-server-and-test dev:alt-test-env http://localhost:5173 \"cypress run --spec 'cypress/alt-client/**/*.cy.ts' --browser chromium\"",
    "e2e:alt:ui": "start-server-and-test dev:alt-test-env http://localhost:5173 \"cypress open --config specPattern='cypress/alt-client/**/*.cy.ts'\"",

    "e2e:all": "cypress run --spec 'cypress/**/*.cy.ts'"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "description": "",
  "devDependencies": {
    "concurrently": "^9.2.1",
    "cypress": "^14.0.3",
    "eslint-plugin-cypress": "^4.1.0",
    "prettier": "^3.8.1",
    "start-server-and-test": "^3.0.5",
    "typescript": "5.4"
  },
  "dependencies": {
    "dotenv": "^17.2.1"
  }
}
